# ─── Eventra Server — Environment Variables ────────────────────────────────
# Copy this file to server/.env for local development.
# In Vercel production: add each variable via the Vercel dashboard or CLI.
# ────────────────────────────────────────────────────────────────────────────

# ── Local development only ──────────────────────────────────────────────────
# The port the local Express server listens on.
PORT=5000

# ── Database ─────────────────────────────────────────────────────────────────
# REQUIRED in production (Vercel) & local development.
# Use a Neon PostgreSQL connection string (with ?sslmode=require), e.g.:
#   postgresql://<user>:<password>@<neon-endpoint>.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require

# ── JWT ──────────────────────────────────────────────────────────────────────
# REQUIRED in production. Use a long random secret (32+ chars).
JWT_SECRET=eventra_platform_production_secret_key_2026_jwt

# ── Admin seed account ───────────────────────────────────────────────────────
# Used when the admins table is empty on first setup.
ADMIN_EMAIL=admin@eventra.dev
ADMIN_PASSWORD=Admin@Eventra2026!

# ── CORS ─────────────────────────────────────────────────────────────────────
# Frontend URL in production, e.g. https://your-project.vercel.app
CLIENT_URL=http://localhost:5173
