# ─── Eventra Server — Environment Variables ────────────────────────────────
# Copy this file to server/.env for local development.
# In Vercel production: add each variable via the Vercel dashboard or CLI.
# ────────────────────────────────────────────────────────────────────────────

# ── Local development only ──────────────────────────────────────────────────
# The port the local Express server listens on.
# Not used on Vercel (serverless functions don't have a persistent port).
PORT=5000

# ── Database ─────────────────────────────────────────────────────────────────
# REQUIRED in production (Vercel).
# Use a MongoDB Atlas connection string, e.g.:
#   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/eventra?retryWrites=true&w=majority
# Without this, the serverless function will fall back to MongoMemoryServer
# which does NOT work on Vercel — all data will be lost on every cold start.
MONGODB_URI=mongodb://127.0.0.1:27017/eventra

# ── JWT ──────────────────────────────────────────────────────────────────────
# REQUIRED in production. Use a long random secret (32+ chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=eventra_platform_production_secret_key_2026_jwt

# ── Admin seed account ───────────────────────────────────────────────────────
# These are used ONLY when the admin collection is empty (first deploy / fresh DB).
# Change the password immediately after the first login.
ADMIN_EMAIL=admin@eventra.dev
ADMIN_PASSWORD=Admin@Eventra2026!

# ── CORS ─────────────────────────────────────────────────────────────────────
# Set this to your Vercel frontend URL in production, e.g.:
#   https://your-project.vercel.app
# Leaving it blank or unset defaults to '*' (allow all origins).
CLIENT_URL=http://localhost:5173
